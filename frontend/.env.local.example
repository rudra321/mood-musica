# The "brain" that turns a mood into a palette + tracklist.
# Get a free key (no credit card) at https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional overrides ---
# Groq model to use (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Swap providers without touching code (must be registered in
# src/core/config/providers.js). Defaults shown.
#   MOOD_INTERPRETER: groq (default, needs GROQ_API_KEY) | rule-based (zero-key, offline)
#   TRACK_RESOLVER:   itunes (default)
# MOOD_INTERPRETER=groq
# TRACK_RESOLVER=itunes
